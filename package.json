{
    "name": "opencode-supertask",
    "version": "0.1.24",
    "description": "AI Agent 任务调度系统 — OpenCode 插件 + CLI + Gateway 常驻进程",
    "type": "module",
    "main": "dist/plugin/supertask.js",
    "types": "dist/plugin/supertask.d.ts",
    "exports": {
        ".": {
            "import": "./dist/plugin/supertask.js",
            "types": "./dist/plugin/supertask.d.ts"
        },
        "./server": {
            "import": "./dist/plugin/supertask.js",
            "types": "./dist/plugin/supertask.d.ts"
        }
    },
    "files": [
        "dist",
        "drizzle",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "bun run src/cli/index.ts",
        "build": "tsup",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun run src/core/db/migrate.ts",
        "ui": "bun run src/web/index.tsx",
        "gateway": "bun run src/gateway/index.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit"
    },
    "bin": {
        "supertask": "dist/cli/index.js"
    },
    "keywords": [
        "opencode",
        "plugin",
        "task",
        "queue",
        "agent",
        "scheduler",
        "supertask"
    ],
    "author": "javazys",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vbgate/opencode-supertask.git"
    },
    "bugs": {
        "url": "https://github.com/vbgate/opencode-supertask/issues"
    },
    "homepage": "https://github.com/vbgate/opencode-supertask#readme",
    "dependencies": {
        "commander": "^13.1.0",
        "cron-parser": "^5.5.0",
        "drizzle-orm": "^0.39.1",
        "glob": "^13.0.0",
        "hono": "^4.7.4"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.1.42",
        "@types/bun": "latest",
        "@types/node": "^25.1.0",
        "drizzle-kit": "^0.30.4",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@opencode-ai/plugin": "^1.1.0"
    },
    "peerDependenciesMeta": {
        "@opencode-ai/plugin": {
            "optional": false
        }
    },
    "engines": {
        "bun": ">=1.0.0"
    }
}
