{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "ESNext",
        "module": "ESNext",
        "moduleDetection": "force",
        "allowJs": true,
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@core/*": [
                "src/core/*"
            ],
            "@worker/*": [
                "src/worker/*"
            ],
            "@web/*": [
                "src/web/*"
            ],
            "@plugin/*": [
                "plugin/*"
            ]
        },
        "rootDir": "."
    },
    "include": [
        "src/**/*",
        "plugin/**/*",
        "scripts/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}